# Copy this file to .env and fill in your keys. Never commit .env.

# Required for the demonstration run (two Anthropic models: Sonnet 5, Opus 4.8).
ANTHROPIC_API_KEY=your_key_here

# Required for the judge (a non-Claude model scores Claude outputs to avoid a
# self-preference objection). Default judge is GPT-5.5; confirm the exact string.
OPENAI_API_KEY=your_key_here
JUDGE_MODEL=gpt-5.5

# Optional: only needed if you activate the framework-supported targets in
# src/run_models.py (GPT / Gemini / open-weight). Not used in the pilot.
GOOGLE_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
